#!/usr/bin/env bash
# Bootstrap CLI tools: mise + manifest tools + ble.sh.
# Runs on `chezmoi apply`; re-runs automatically when the mise manifest
# changes (its hash is embedded below by chezmoi's templating).
# mise manifest sha256: {{ include "private_dot_config/mise/config.toml" | sha256sum }}
set -euo pipefail

log() { printf '[install-tools] %s\n' "$*"; }

# 1. mise itself — pinned version, sha256-verified before it is
#    executed (same trust-anchor model as the chezmoi install in the
#    README; bump both values to upgrade mise).
MISE_VERSION="2026.8.3"
MISE_SHA256="66585ac496c10bf6fbf13272e3e550c1813aed0e1cb780b9bb73c1751de49289"
if ! command -v mise >/dev/null 2>&1 && [ ! -x "$HOME/.local/bin/mise" ]; then
  log "installing mise $MISE_VERSION"
  tmp_bin="$(mktemp)"
  curl -fsSL -o "$tmp_bin" "https://github.com/jdx/mise/releases/download/v${MISE_VERSION}/mise-v${MISE_VERSION}-linux-x64"
  echo "$MISE_SHA256  $tmp_bin" | sha256sum -c -
  install -m 755 "$tmp_bin" "$HOME/.local/bin/mise"
  rm -f "$tmp_bin"
else
  log "mise already installed, skipping"
fi
export PATH="$HOME/.local/bin:$PATH"

# 2. Tools from the manifest (~/.config/mise/config.toml, deployed by
#    this same apply — this script runs after files are written).
log "mise install"
mise install --yes

# 3. ble.sh — not available via mise, install from the nightly tarball.
if [ ! -f "$HOME/.local/share/blesh/ble.sh" ]; then
  log "installing ble.sh"
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  curl -fsSL https://github.com/akinomyoga/ble.sh/releases/download/nightly/ble-nightly.tar.xz | tar xJf - -C "$tmp"
  bash "$tmp/ble-nightly/ble.sh" --install "$HOME/.local/share"
  rm -rf "$tmp"
  trap - EXIT
else
  log "ble.sh already installed, skipping"
fi

# 4. System packages — not available via mise (real debuggers etc.).
#    Needs sudo; on a fresh host `chezmoi apply` runs interactively so the
#    password prompt just works. In non-interactive contexts without cached
#    sudo credentials, skip with a hint instead of failing the apply.
apt_packages=(gdb strace ltrace lldb valgrind)
missing=()
for pkg in "${apt_packages[@]}"; do
  command -v "$pkg" >/dev/null 2>&1 || missing+=("$pkg")
done
if [ "${#missing[@]}" -gt 0 ]; then
  if sudo -n true 2>/dev/null; then
    log "installing system packages: ${missing[*]}"
    sudo apt-get update && sudo apt-get install -y "${missing[@]}"
  else
    log "SKIP: missing system packages (need sudo): ${missing[*]}"
    log "      run: sudo apt-get install -y ${missing[*]}"
  fi
fi

log "done"
