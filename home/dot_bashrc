#!/usr/bin/env bash
# Pure configuration — nothing here installs anything or touches the
# network. Tools are installed by chezmoi's run_onchange_install-tools
# script (mise + ble.sh); this file only activates what is present.

BLESH="$HOME/.local/share/blesh/ble.sh"
BLERC="$HOME/.local/share/blesh/blerc"

# --- PATH -------------------------------------------------------------------
# Each dir is prepended, so list them lowest priority first: mise shims
# end up ahead of any leftover rustup/cargo installs under ~/.cargo/bin.
path_dirs=(
  "$HOME/.cargo/bin"
  "$HOME/.local/bin"
  "$HOME/.local/share/mise/shims"
  "$HOME/.kimi-code/bin"
)
for d in "${path_dirs[@]}"; do
  if [ -d "$d" ]; then
    case ":$PATH:" in
      *":$d:"*) ;; # already on PATH
      *) PATH="$d:$PATH" ;;
    esac
  fi
done
export PATH

_safe_alias() {
  if [ $# -ne 1 ]; then
    echo "missing alias arguments"
  fi
  local -r arg=$1
  local ali
  local cmd
  ali=${arg%%=*} # removes everything after the first '='
  cmd=${arg#*=}  # removes everything before the first '='
  if ! alias "$ali" &>/dev/null; then
    eval "alias $ali=\"$cmd\""
  fi
}

# --- Integrations -------------------------------------------------------------
# Each integration is guarded: if the tool is not installed, the shell
# starts cleanly without it.

# ble.sh — only if installed; ble-import needs ble.sh fully loaded, which
# can still fail in sessions without a TTY (hence the BLE_VERSION check).
# shellcheck disable=SC1090
if [[ $- == *i* ]] && [ -f "$BLESH" ]; then
  source "$BLESH" --noattach --rcfile "$BLERC"
  if [[ ${BLE_VERSION-} ]]; then
    ble-import -d integration/fzf-completion
    ble-import -d integration/fzf-key-bindings
  fi
fi

set -o vi

# default ls flags; an environment-provided LS_OPTIONS still wins
: "${LS_OPTIONS:=--color=auto}"
_safe_alias ls="ls $LS_OPTIONS"

# use neovim (mise-managed) as vim
_safe_alias vim="nvim"

# starship — only if on PATH (mise shims or otherwise).
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash)"
fi

# fzf — only if on PATH and ble.sh is not loaded (ble.sh has its own fzf
# integration via ble-import above; loading both would double-bind keys).
if [[ ! ${BLE_VERSION-} ]] && command -v fzf >/dev/null 2>&1; then
  eval "$(fzf --bash)"
fi

[[ ! ${BLE_VERSION-} ]] || ble-attach
